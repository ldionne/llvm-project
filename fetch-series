#!/usr/bin/env python3
"""
Fetch every benchmark series from an LNT instance into a local cache.

Deliberately dumb: one paginated walk of /query per (machine, metric), dumping
raw rows to JSONL. No filtering, no aggregation, no incremental updates. Rerun
it when you want fresher data.

Samples are cached *raw*, one row per benchmark run, rather than aggregated per
commit. Aggregation is a choice the analysis makes (and one we may want to
revisit), and the raw replicates are also what a within-commit noise estimate
needs, so the cache keeps them.

Usage:
    ./fetch-series                       # every machine, execution_time
    ./fetch-series --machine linux-x86_64-20260812
    ./fetch-series --metric execution_time --output-dir cache
"""

import argparse
import json
import pathlib
import sys
import time
import urllib.error
import urllib.request

# The server rejects urllib's default User-Agent with a 403, so every request
# has to carry one of its own.
HEADERS = {'Content-Type': 'application/json', 'User-Agent': 'lnt-fetch-series/1'}

PAGE_SIZE = 10000       # the maximum the API allows
RETRIES = 4


def request(url, body=None, retries=RETRIES):
    """GET (or POST, when given a body) with a few retries on transient failures."""
    data = json.dumps(body).encode() if body is not None else None
    for attempt in range(1, retries + 1):
        try:
            return json.load(urllib.request.urlopen(
                urllib.request.Request(url, data=data, headers=HEADERS), timeout=120))
        except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError) as error:
            # A 4xx other than 429 is our fault and will not fix itself.
            code = getattr(error, 'code', None)
            if code is not None and 400 <= code < 500 and code != 429:
                raise
            if attempt == retries:
                raise
            delay = 2 ** attempt
            print(f'  request failed ({error}), retrying in {delay}s '
                  f'[{attempt}/{retries - 1}]', file=sys.stderr)
            time.sleep(delay)


def machines(base, suite):
    """Every machine name in the suite."""
    names, cursor = [], None
    while True:
        url = f'{base}/api/v5/{suite}/machines?limit=1000'
        if cursor:
            url += f'&cursor={cursor}'
        page = request(url)
        names += [machine['name'] for machine in page['items']]
        cursor = page['cursor']['next']
        if not cursor:
            return names


def fetch(base, suite, machine, metric, destination):
    """Walk /query for one (machine, metric) and write every row to `destination`."""
    rows = pages = 0
    cursor = None
    started = time.time()
    # Written to a temporary file and renamed at the end, so an interrupted fetch
    # never leaves a half-written cache entry that looks complete.
    partial = destination.with_suffix('.partial')
    with partial.open('w') as out:
        while True:
            body = {'metric': metric, 'machine': machine, 'sort': 'commit',
                    'limit': PAGE_SIZE}
            if cursor:
                body['cursor'] = cursor
            page = request(f'{base}/api/v5/{suite}/query', body)
            for item in page['items']:
                out.write(json.dumps(item) + '\n')
            rows += len(page['items'])
            pages += 1
            cursor = page['cursor']['next']
            print(f'\r  {machine} / {metric}: {rows:,} rows, {pages} pages, '
                  f'{time.time() - started:.0f}s', end='', file=sys.stderr, flush=True)
            if not cursor:
                break
    print(file=sys.stderr)
    partial.rename(destination)
    return rows, pages, time.time() - started


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--lnt-url', default='https://lnt.ldionne.com')
    parser.add_argument('--test-suite', default='libcxx')
    parser.add_argument('--machine', action='append', metavar='NAME',
        help='Machine to fetch; repeatable. Defaults to every machine in the suite.')
    parser.add_argument('--metric', action='append', metavar='NAME',
        help='Metric to fetch; repeatable. Defaults to execution_time, which is '
             'the only one this instance currently holds any data for.')
    parser.add_argument('--output-dir', type=pathlib.Path, default=pathlib.Path('cache'))
    parser.add_argument('--force', action='store_true',
        help='Refetch machines whose cache file already exists.')
    args = parser.parse_args(argv)

    base = args.lnt_url.rstrip('/')
    names = args.machine or machines(base, args.test_suite)
    metrics = args.metric or ['execution_time']
    args.output_dir.mkdir(parents=True, exist_ok=True)
    print(f'{len(names)} machine(s) x {len(metrics)} metric(s) -> {args.output_dir}/',
          file=sys.stderr)

    manifest = []
    for machine in names:
        for metric in metrics:
            destination = args.output_dir / f'{machine}.{metric}.jsonl'
            if destination.exists() and not args.force:
                existing = sum(1 for _ in destination.open())
                print(f'  {destination.name}: {existing:,} rows already cached, '
                      f'skipping (--force to refetch)', file=sys.stderr)
                manifest.append({'machine': machine, 'metric': metric,
                                 'rows': existing, 'cached': True})
                continue
            (rows, pages, elapsed) = fetch(base, args.test_suite, machine, metric,
                                           destination)
            manifest.append({'machine': machine, 'metric': metric, 'rows': rows,
                             'pages': pages, 'seconds': round(elapsed, 1)})
            if rows == 0:
                print(f'  note: {machine} / {metric} holds no data', file=sys.stderr)

    (args.output_dir / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    total = sum(entry['rows'] for entry in manifest)
    print(f'{total:,} rows cached in {args.output_dir}/', file=sys.stderr)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
