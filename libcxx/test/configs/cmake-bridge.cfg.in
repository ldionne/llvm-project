@AUTO_GEN_COMMENT@

@SERIALIZED_LIT_PARAMS@

#
# This file bridges the CMake configuration of the standalone test-suite project and the Lit
# configuration files: it sets up the LitConfig object, the test format, and the harness
# substitutions (those independent of the library under test). It is generated by the test-suite
# project and loaded by the generated lit.site.cfg *before* any driver-provided config fragment
# and the site configuration file.
#

import os, site
import shlex
import sys
site.addsitedir(os.path.join('@CMAKE_CURRENT_SOURCE_DIR@', '..', 'utils'))
import libcxx.test.format

# Basic configuration of the test suite
config.name = os.path.basename('@STLTEST_CONFIG@')
config.test_source_root = '@CMAKE_CURRENT_SOURCE_DIR@'
config.test_format = libcxx.test.format.CxxStandardLibraryTest()
config.recursiveExpansionLimit = 10
config.test_exec_root = '@CMAKE_CURRENT_BINARY_DIR@'

# Harness substitutions, independent of the library under test.
config.substitutions.append(('%{libcxx-dir}', os.path.realpath(os.path.join('@CMAKE_CURRENT_SOURCE_DIR@', '..'))))
config.substitutions.append(('%{benchmark_flags}', '-I @CMAKE_CURRENT_BINARY_DIR@/benchmarks/google-benchmark/include -L @CMAKE_CURRENT_BINARY_DIR@/benchmarks/google-benchmark/lib -L @CMAKE_CURRENT_BINARY_DIR@/benchmarks/google-benchmark/lib64 -l benchmark'))
config.substitutions.append(("%{python}", shlex.quote(sys.executable)))
